{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athena",
  "version": "1.0.70",
  "identifier": "com.athena.search",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Athena — Second Brain",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
