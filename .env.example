# Athena-Search — copy to .env and fill in real values
# Full reference: see server/.env.example

# Server
PORT=8787
HOST=0.0.0.0
# Reverse-proxy IPs whose X-Forwarded-For / CF-Connecting-IP we trust (rate limiting)
TRUSTED_PROXY_IPS=127.0.0.1,::1
DATABASE_URL=postgresql://athena:CHANGEME@localhost:5432/athena
ATHENA_ASSETS=./public

# Owner IDs (comma-separated). Leave empty → first user becomes GOD
TG_OWNER_IDS=
DISCORD_OWNER_IDS=

# Telegram
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Encryption key for stored tokens
STORAGE_KEY=

# Backups (optional)
BACKUP_INTERVAL_HOURS=6
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_TELEGRAM_TOKEN=

# Google Drive backup (optional — only runs if all three are set)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# Local Telegram Bot API (optional)
TELEGRAM_API_BASE=

# Frontend URL (leave blank if server also serves UI)
ATHENA_FRONTEND_URL=

# Worker-only
WEBHOOK_ALLOW_UNSIGNED=

# Cloudflare cache purge (optional — auto-purges on server start)
CF_PURGE_CACHE=1
CF_ZONE_ID=
CF_API_EMAIL=
CF_API_KEY=
