# Athena self-hosted mode
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgresql://athena:CHANGEME@localhost:5432/athena
ATHENA_ASSETS=./public
# Reverse-proxy IPs whose X-Forwarded-For / CF-Connecting-IP we trust (rate limiting).
# Direct callers get their socket address instead, so the header cannot be spoofed.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Ranks — leave empty and the first logged-in user is GOD (fine for a private box)
TG_OWNER_IDS=
DISCORD_OWNER_IDS=

# Telegram login + bot
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Encrypts the stored GitHub token at rest
STORAGE_KEY=

# Backups
BACKUP_INTERVAL_HOURS=6
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_TELEGRAM_TOKEN=

# Google Drive backup (optional — only runs if all three are set)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# Local Telegram Bot API server (optional, raises upload cap to 2GB)
TELEGRAM_API_BASE=

# Where the browser lives (the Cloudflare page). OAuth returns here.
# Leave blank if this server also serves the UI.
ATHENA_FRONTEND_URL=
# Cloudflare Worker origin used to mirror instance AI settings (optional).
ATHENA_AI_PEER_URL=
# Comma-separated additional browser origins, e.g. the Cloudflare Worker URL
ATHENA_ALLOWED_ORIGINS=

# Optional Meilisearch accelerator; PostgreSQL remains the source of truth.
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=
MEILI_INDEX=athena

# Optional Kage + Chrome/Chromium for JS-rendered link scraping.
KAGE_BIN=
KAGE_CHROME=
