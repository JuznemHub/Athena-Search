# Copy into wrangler.toml [vars] or set as secrets.

# --- Telegram OIDC (website login) ---
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=   # wrangler secret put TELEGRAM_CLIENT_SECRET

# --- Bot messaging (dumps / commands) ---
TELEGRAM_BOT_TOKEN=       # wrangler secret put TELEGRAM_BOT_TOKEN

# --- Discord OAuth (optional) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=    # wrangler secret put DISCORD_CLIENT_SECRET

# --- Instance owners (comma-separated) ---
# Empty TG_OWNER_IDS and DISCORD_OWNER_IDS = everyone is full owner (typical self-host).
# When set: only these IDs get personal mode, AI, bot settings.
# Telegram: Bot API numeric id AND/OR OIDC provider_id (sub).
# Discord: numeric user id.
TG_OWNER_IDS=123456789,987654321
DISCORD_OWNER_IDS=

# Member flow when owners are configured:
# 1) Login on website
# 2) DM bot → /start (shows restriction)
# 3) /community_join <community_id>
# 4) Dump only after join; AI locked
